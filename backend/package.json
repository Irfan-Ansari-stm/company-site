    "test:admin": "node src/tests/admin-tools.test.js",
    "test:cms": "node src/tests/cms-public-api.test.js",
    "test:speed": "node src/tests/public-website-speed-suite.test.js",
    "test:auth": "node src/tests/auth-lifecycle.test.js",
    "test:rate-limit": "node src/tests/auth-rate-limiting.test.js",
    "test:all": "npm run test:rbac && npm run test:dashboard && npm run test:crm && npm run test:work && npm run test:enterprise && npm run test:admin && npm run test:cms && npm run test:speed && npm run test:auth && npm run test:rate-limit",
